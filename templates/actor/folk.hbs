<section class="gg-folk-card">
  <header class="gg-card-title">
    <img class="gg-art" src="{{img}}" alt="">
    <div>
      <h2>{{name}}</h2>
      {{#if farm}}<p class="gg-breed">{{farm}}</p>{{/if}}
    </div>
  </header>
  <p>{{role}}</p>
  <p class="gg-foot">The system moves this token: the Storyteller just clicks Farmer's Turn.</p>
</section>
